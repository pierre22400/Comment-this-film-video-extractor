# Relais serveur Gemini — copier en .env et renseigner les valeurs réelles.
# NE JAMAIS committer de vraie clé. Seul ce fichier .env.example est suivi par Git.

# Clé d'API Google Gemini (obligatoire côté serveur uniquement).
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle Gemini Flash multimodal (optionnel ; valeur par défaut si absent).
GEMINI_MODEL=gemini-2.5-flash

# Interface et port d'écoute du relais local (optionnels).
RELAY_HOST=127.0.0.1
RELAY_PORT=8787

# Origine de l'extension autorisée à appeler le relais (CORS).
# Sans cette valeur, aucune origine de navigateur n'est acceptée (les appels
# sans origine, comme curl ou les tests serveur, restent permis).
#
# Comment récupérer l'identifiant :
#   1. Ouvrir chrome://extensions
#   2. Activer le « Mode développeur » (en haut à droite)
#   3. Charger l'extension via « Charger l'extension non empaquetée » -> dossier dist/
#   4. Repérer l'« ID » affiché sous le nom de l'extension (ex : abcdefghijklmnopabcdefghijklmnop)
#   5. Renseigner ci-dessous : chrome-extension://<ID>
ALLOWED_EXTENSION_ORIGIN=chrome-extension://your_extension_id_here

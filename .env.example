# Relais serveur Gemini — copier en .env et renseigner les valeurs réelles.
# NE JAMAIS committer de vraie clé. Seul ce fichier .env.example est suivi par Git.

# Clé d'API Google Gemini (obligatoire côté serveur uniquement).
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle Gemini Flash multimodal (optionnel ; valeur par défaut si absent).
GEMINI_MODEL=gemini-2.5-flash

# Interface et port d'écoute du relais local (optionnels).
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
